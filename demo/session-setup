#!/usr/bin/env bash
#
# Run inside the screenshot session: name its workspaces like the made-up ones
# in demo/herdr, and report made-up agents on their panes, so herdr's sidebar
# matches what the pickers show.

set -euo pipefail

dir="${DEMO_DIR:?run through demo/screenshots}"

ws_id() { herdr workspace list | jq -r --arg l "$1" '.result.workspaces[] | select(.label == $l) | .workspace_id'; }
root_pane() { herdr pane list --workspace "$1" | jq -r '.result.panes[0].pane_id'; }

# agent <pane> <agent> <state> <title> [name]: show a made-up agent in the sidebar.
# "done" is herdr's name for an agent that went idle after working in a
# workspace that isn't focused.
agent() {
  local pane="$1" kind="$2" state="$3" title="$4" name="${5:-}"
  if [ "$state" = "done" ]; then
    herdr pane report-agent --source demo --agent "$kind" --state working "$pane" >/dev/null
    state=idle
  fi
  herdr pane report-agent --source demo --agent "$kind" --state "$state" "$pane" >/dev/null
  # report-metadata takes the pane id before its options
  herdr pane report-metadata "$pane" --source demo --agent "$kind" --title "$title" >/dev/null
  if [ -n "$name" ]; then herdr agent rename "$pane" "$name" >/dev/null; fi
}

first="$(herdr workspace list | jq -r '.result.workspaces[0].workspace_id')"
herdr workspace rename "$first" my-web-app >/dev/null

for label in api-server dotfiles notes infra; do
  mkdir -p "$dir/$label"
  herdr workspace create --cwd "$dir/$label" --label "$label" --no-focus >/dev/null
done

# The same agents as `agent list` in demo/herdr.
agent "$(root_pane "$first")" claude working "ログイン画面のバリデーションを追加" login-form
api="$(root_pane "$(ws_id api-server)")"
agent "$api" claude blocked "Add cursor pagination to /users" pagination
split="$(herdr pane split "$api" --direction right | jq -r '.result.pane.pane_id')"
agent "$split" codex "done" "CI の flaky なテストを直す" flaky-test
agent "$(root_pane "$(ws_id infra)")" claude idle "Review the Terraform plan"
agent "$(root_pane "$(ws_id dotfiles)")" claude "done" "Update the Neovim LSP config" nvim
