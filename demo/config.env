# Demo mode for screenshots: the pickers show made-up workspaces, directories
# and agents instead of yours, and picking an entry does nothing.
#
#   cp demo/config.env "$(herdr plugin config-dir isseii10.herdr-pickers)/config.env"
#
# Remove that config.env again when you are done.
# Needs this checkout to be the installed plugin (herdr plugin link), so that
# HERDR_PLUGIN_ROOT points here.

herdr="$HERDR_PLUGIN_ROOT/demo/herdr"
PATH="$HERDR_PLUGIN_ROOT/demo/bin:$PATH"
