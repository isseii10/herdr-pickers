#!/usr/bin/env bash
#
# rank-groups <query> <file>... [-- <fzf matching options>...]
#
# Print the lines of each file that match <query>, best match first within each
# file, file after file. Used as an fzf reload command so that one group (open
# workspaces) always stays above the next (zoxide directories) while searching,
# which fzf's own sort can't do: it ranks all lines together.
# An empty query prints the files unchanged.

set -uo pipefail

query="$1"
shift
files=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  files+=("$1")
  shift
done
[ "${1:-}" = "--" ] && shift

for f in "${files[@]}"; do
  if [ -z "$query" ]; then
    cat "$f"
  else
    # fzf --filter --ansi prints lines with their colors stripped, so it only
    # decides the order: each result is swapped back for the original colored
    # line, looked up by its first two columns (kind and id/path, uncolored).
    # shellcheck disable=SC2094 # both sides only read "$f"
    fzf "$@" --filter "$query" <"$f" | # exits 1 when nothing matches
      awk -F'\t' 'NR == FNR { line[$1 FS $2] = $0; next }
                  ($1 FS $2) in line { print line[$1 FS $2] }' "$f" -
  fi
done
exit 0
