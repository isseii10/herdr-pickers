# herdr-pickers settings.
# Copy to: $(herdr plugin config-dir isseii10.herdr-pickers)/config.env
# Plain shell, sourced by the pickers. Every line is optional.

# Directories prepended to PATH (herdr runs plugins with the server's environment,
# which often lacks Homebrew / Nix paths). Default:
# HERDR_PICKERS_PATH="$HOME/.nix-profile/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"

# Colors (#rrggbb). Defaults follow herdr's one-dark theme.
# HERDR_PICKERS_COLOR_BLUE="#61afef"    # workspace icon / workspace column
# HERDR_PICKERS_COLOR_GREEN="#98c379"   # "current" marker / done agents
# HERDR_PICKERS_COLOR_YELLOW="#e5c07b"  # directory icon / working agents
# HERDR_PICKERS_COLOR_RED="#e06c75"     # blocked agents
# HERDR_PICKERS_COLOR_GRAY="#5c6370"    # dim text / idle agents

# Popup size: "80%" (of the terminal) or a number of cells.
# HERDR_PICKERS_WORKSPACE_WIDTH="60%"
# HERDR_PICKERS_WORKSPACE_HEIGHT="60%"
# HERDR_PICKERS_AGENT_WIDTH="80%"
# HERDR_PICKERS_AGENT_HEIGHT="80%"

# agent picker
# HERDR_PICKERS_AGENT_TITLE_MAX=50       # cut titles longer than this (display width)
# HERDR_PICKERS_AGENT_PREVIEW_LINES=200  # lines of agent output in the preview
