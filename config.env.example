# herdr-vipicker settings.
# Copy to: $(herdr plugin config-dir isseii10.herdr-vipicker)/config.env
# Plain shell, sourced by the pickers. Every line is optional.

# Popup size: "80%" (of the terminal) or a number of cells.
# HERDR_VIPICKER_WORKSPACE_WIDTH="70%"
# HERDR_VIPICKER_WORKSPACE_HEIGHT="70%"
# HERDR_VIPICKER_AGENT_WIDTH="70%"
# HERDR_VIPICKER_AGENT_HEIGHT="70%"

# agent picker
# HERDR_VIPICKER_AGENT_TITLE_MAX=50       # cut titles longer than this (display width)
# HERDR_VIPICKER_AGENT_PREVIEW_LINES=200  # lines of agent output in the preview
