# herdr-pickers settings.
# Copy to: $(herdr plugin config-dir isseii10.herdr-pickers)/config.env
# Plain shell, sourced by the pickers. Every line is optional.

# Popup size: "80%" (of the terminal) or a number of cells.
# HERDR_PICKERS_WORKSPACE_WIDTH="60%"
# HERDR_PICKERS_WORKSPACE_HEIGHT="60%"
# HERDR_PICKERS_AGENT_WIDTH="80%"
# HERDR_PICKERS_AGENT_HEIGHT="80%"

# agent picker
# HERDR_PICKERS_AGENT_TITLE_MAX=50       # cut titles longer than this (display width)
# HERDR_PICKERS_AGENT_PREVIEW_LINES=200  # lines of agent output in the preview
