#!/usr/bin/env bash
#
# pane.focused hook: append "<epoch>\t<workspace_id>\t<pane_id>" to the focus
# log in the plugin state dir. The pickers read it to put recently used
# workspaces and agents first.
#
# Runs on every focus change, so it stays dependency-free (no jq) and cheap.

set -euo pipefail

json="${HERDR_PLUGIN_EVENT_JSON:-}"
[[ "$json" =~ \"pane_id\":\"([^\"]+)\" ]] || exit 0
pane="${BASH_REMATCH[1]}"
[[ "$json" =~ \"workspace_id\":\"([^\"]+)\" ]] || exit 0
ws="${BASH_REMATCH[1]}"

dir="${HERDR_PLUGIN_STATE_DIR:?}"
mkdir -p "$dir"
log="$dir/focus.log"
printf '%s\t%s\t%s\n' "$(date +%s)" "$ws" "$pane" >>"$log"

# Keep the log small: only the latest entry per id matters.
if [ "$(wc -l <"$log")" -gt 1000 ]; then
  tmp="$(mktemp "$dir/focus.log.XXXXXX")"
  tail -n 300 "$log" >"$tmp" && mv "$tmp" "$log"
fi
