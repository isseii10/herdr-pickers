#!/usr/bin/env bash
#
# PreToolUse hook (Bash): ask the user before anything that would put commits
# on main, because every push to main is a release (see CLAUDE.md).
#
# The permission "ask" rules in settings.json catch pushes that name main. This
# hook adds what a rule can't see: a push with no refspec while main is checked
# out, and the same commands inside compound commands.

input="$(cat)"
cwd="$(jq -r '.cwd // empty' <<<"$input")"
# Drop quoted text first (across lines), so words in a commit message or an
# echo don't count.
cmd="$(jq -r '.tool_input.command // "" | gsub("'"'"'[^'"'"']*'"'"'"; "") | gsub("\"([^\"\\\\]|\\\\.)*\""; "")' <<<"$input")"

ask() {
  jq -n --arg reason "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse",
    permissionDecision: "ask", permissionDecisionReason: $reason}}'
  exit 0
}

if [[ "$cmd" =~ (^|[^[:alnum:]_-])gh[[:space:]]+pr[[:space:]]+merge ]]; then
  ask "Merging a pull request into main publishes a release. Merge only when the user said so."
fi

# Check each `git ... push` in the command on its own.
branch="$(git -C "${cwd:-.}" symbolic-ref --quiet --short HEAD 2>/dev/null)"
while IFS= read -r part; do
  [[ "$part" =~ (^|[[:space:]])git([[:space:]]+[^[:space:]]+)*[[:space:]]+push([[:space:]]+(.*))?$ ]] || continue
  read -ra words <<<"${BASH_REMATCH[4]}"
  positional=0
  for w in "${words[@]}"; do
    case "$w" in -* | *'>'* | *'<'*) continue ;; esac # options and redirections
    positional=$((positional + 1))
    case "$w" in main | *:main | refs/heads/main | *:refs/heads/main)
      ask "This pushes to main, which publishes a release. Push only when the user said to merge." ;;
    esac
  done
  # Only a remote (or nothing) given: git pushes the current branch.
  if [ "$positional" -le 1 ] && [ "$branch" = main ]; then
    ask "main is checked out and this push names no branch, so it may update main and publish a release. Push only when the user said to merge."
  fi
done < <(tr ';&|' '\n' <<<"$cmd")
exit 0
